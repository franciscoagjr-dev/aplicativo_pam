<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. O Dobro do Número"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="8dp"/>

        <EditText
            android:id="@+id/etNumeroDobro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite um número inteiro"
            android:inputType="number"/>

        <Button
            android:id="@+id/btnCalcularDobro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calcular Dobro"/>

        <TextView
            android:id="@+id/tvResultadoDobro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resultado: "
            android:paddingTop="8dp"
            android:paddingBottom="16dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#333333"
            android:layout_marginBottom="16dp"
            android:text=""/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Conversor de Idade para Dias"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="8dp"/>

        <EditText
            android:id="@+id/etIdadeDias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite sua idade em anos"
            android:inputType="number"/>

        <Button
            android:id="@+id/btnCalcularDias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Converter para Dias"/>

        <TextView
            android:id="@+id/tvResultadoDias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resultado: "
            android:paddingTop="8dp"
            android:paddingBottom="16dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#333333"
            android:layout_marginBottom="16dp"
            android:text=""/>



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Calculadora de Gorjeta (10%)"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="8dp"/>

        <EditText
            android:id="@+id/etValorConta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Valor total da conta (ex: 80.50)"
            android:inputType="numberDecimal"/>

        <Button
            android:id="@+id/btnCalcularGorjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calcular Gorjeta"/>

        <TextView
            android:id="@+id/tvResultadoGorjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resultado: "
            android:paddingTop="8dp"
            android:paddingBottom="16dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#333333"
            android:layout_marginBottom="16dp"
            android:text=""/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Conversor de Dólar para Real"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="8dp"/>

        <EditText
            android:id="@+id/etValorDolar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Valor em Dólares"
            android:inputType="numberDecimal"/>

        <Button
            android:id="@+id/btnConverterMoeda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Converter para Reais"/>

        <TextView
            android:id="@+id/tvResultadoMoeda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resultado: "
            android:paddingTop="8dp"
            android:paddingBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#333333"
            android:layout_marginBottom="16dp"
            android:text=""/>



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5. Média de Duas Notas"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="8dp"/>

        <EditText
            android:id="@+id/etNota1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nota 1"
            android:inputType="numberDecimal"/>

        <EditText
            android:id="@+id/etNota2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nota 2"
            android:inputType="numberDecimal"/>

        <Button
            android:id="@+id/btnCalcularMedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calcular Média"/>

        <TextView
            android:id="@+id/tvResultadoMedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resultado: "
            android:paddingTop="8dp"
            android:paddingBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#333333"
            android:layout_marginBottom="16dp"
            android:text=""/>



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="6. Classificador de Categoria por Idade"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="8dp"/>

        <EditText
            android:id="@+id/etIdadeCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite a idade"
            android:inputType="number"/>

        <Button
            android:id="@+id/btnClassificarIdade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Classificar Categoria"/>

        <TextView
            android:id="@+id/tvResultadoCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resultado: "
            android:paddingTop="8dp"
            android:paddingBottom="16dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#333333"
            android:layout_marginBottom="16dp"
            android:text=""/>



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="7. Analisador de Desconto Progressivo"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="8dp"/>

        <EditText
            android:id="@+id/etValorCompra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite o valor total da compra"
            android:inputType="numberDecimal"/>

        <Button
            android:id="@+id/btnCalcularDesconto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calcular Desconto"/>

        <TextView
            android:id="@+id/tvResultadoDesconto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resultado: "
            android:paddingTop="8dp"
            android:paddingBottom="16dp"/>

    </LinearLayout>
</ScrollView>